# cargo-sweep-timer config. Sourced by bash, so $HOME expands.
# Variables already set in the environment override these values.

# Daily sweep time, HH:MM in 24-hour local time. Run ./install.sh again after a change.
SWEEP_TIME=10:00

# Remove artifacts not used for this many seconds: 3600 = 1 hour, 21600 = 6 hours, 86400 = 1 day,
# 604800 = 7 days. SWEEP_MAX_AGE replaces SWEEP_DAYS. On relatime or noatime mounts, a value below
# 86400 can remove artifacts that builds still use. See the README.
SWEEP_MAX_AGE=86400

# Colon-separated dirs searched for Cargo target dirs of any name, at any depth, hidden dirs included.
SWEEP_ROOTS="$HOME/git"

# Colon-separated target dirs that live outside any project (CARGO_TARGET_DIR builds).
SWEEP_TARGET_DIRS=""
