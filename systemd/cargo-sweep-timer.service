[Unit]
Description=Remove stale Cargo build artifacts
Documentation=https://github.com/dannyfranca/cargo-sweep-timer

[Service]
Type=oneshot
# systemd user services do not inherit the login shell PATH, so rustup installs need it set.
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cargo-sweep-timer
# Sweeping hundreds of GB can take long; background priority keeps it out of the way.
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
