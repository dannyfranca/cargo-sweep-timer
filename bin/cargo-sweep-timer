#!/usr/bin/env bash
# Removes stale Cargo build artifacts. Cargo never deletes superseded artifacts,
# so target dirs grow without bound until the disk fills.
set -euo pipefail

usage() {
  cat <<USAGE
Usage: cargo-sweep-timer [--dry-run] [--help]

Removes Cargo build artifacts not used for SWEEP_MAX_AGE seconds.

Config file: \${CARGO_SWEEP_TIMER_CONFIG:-\${XDG_CONFIG_HOME:-~/.config}/cargo-sweep-timer/config.env}
Variables already set in the environment override the config file.

  SWEEP_MAX_AGE      Age threshold in whole seconds (default: 86400). It replaces SWEEP_DAYS.
                     3600 = 1 hour, 21600 = 6 hours, 86400 = 1 day, 604800 = 7 days.
                     On relatime or noatime mounts, a value below 86400 can remove artifacts that builds still use.
  SWEEP_ROOTS        Colon-separated dirs searched for Cargo target dirs at any depth (default: ~/git)
  SWEEP_TARGET_DIRS  Colon-separated target dirs outside any project, as set by CARGO_TARGET_DIR (default: none)
  DRY_RUN            1 to only report what would be removed (default: 0)
USAGE
}

for arg in "$@"; do
  case $arg in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

# launchd has no log rotation for user agents. It opens the log with O_APPEND, so
# truncation here is safe: later writes start at the new end of the file.
log=${CARGO_SWEEP_TIMER_LOG:-}
if [[ -n $log && -n $(find "$log" -size +1048576c 2>/dev/null) ]]; then
  : >"$log"
fi

settings=(SWEEP_MAX_AGE SWEEP_ROOTS SWEEP_TARGET_DIRS DRY_RUN)
# macOS ships bash 3.2, which lacks associative arrays and [[ -v ]].
for name in "${settings[@]}"; do
  # A caller that exports override_<SETTING> must not inject a setting.
  unset "override_$name"
  [[ -n ${!name+set} ]] && printf -v "override_$name" '%s' "${!name}"
done

config=${CARGO_SWEEP_TIMER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cargo-sweep-timer/config.env}
if [[ -f $config ]]; then
  # shellcheck source=/dev/null
  source "$config"
elif [[ -n ${CARGO_SWEEP_TIMER_CONFIG:-} ]]; then
  echo "config file not found: $config" >&2
  exit 2
fi

for name in "${settings[@]}"; do
  override=override_$name
  [[ -n ${!override+set} ]] && printf -v "$name" '%s' "${!override}"
done

# A silent fallback to the default would sweep at an age the user did not choose.
if [[ -n ${SWEEP_DAYS+set} ]]; then
  echo "SWEEP_MAX_AGE replaces SWEEP_DAYS. Set SWEEP_MAX_AGE in seconds, such as 86400 for 1 day." >&2
  exit 2
fi

SWEEP_MAX_AGE=${SWEEP_MAX_AGE:-86400}
SWEEP_ROOTS=${SWEEP_ROOTS-$HOME/git}
SWEEP_TARGET_DIRS=${SWEEP_TARGET_DIRS:-}
DRY_RUN=${DRY_RUN:-0}

# bash arithmetic wraps above 2^63, and a wrapped age can remove every artifact. 12 digits is
# more than 30,000 years.
if ! [[ $SWEEP_MAX_AGE =~ ^[0-9]{1,12}$ ]]; then
  echo "SWEEP_MAX_AGE must be a whole number of seconds with at most 12 digits, such as 86400, got: $SWEEP_MAX_AGE" >&2
  exit 2
fi
if ! cargo sweep --version >/dev/null 2>&1; then
  echo "cargo-sweep is not installed: https://github.com/holmgr/cargo-sweep" >&2
  exit 1
fi

sweep_args=(--file)
[[ $DRY_RUN == 1 ]] && sweep_args+=(--dry-run)

failures=0

sweep() {
  # cargo-sweep 0.8.0 can exit successfully after logging a cleanup failure.
  if ! cargo sweep "$@" 2>&1 | (
    cleanup_failed=0
    while IFS= read -r line || [[ -n $line ]]; do
      printf '%s\n' "$line"
      case $line in
        '[ERROR] '*|'[WARN] Failed to remove:'*) cleanup_failed=1 ;;
      esac
    done
    exit "$cleanup_failed"
  ); then
    failures=$((failures + 1))
  fi
}

# cargo-sweep resolves the target dir through `cargo metadata`, which needs a project.
# An empty anchor project lets CARGO_TARGET_DIR alone pick which dir gets swept.
anchor=$(mktemp -d)
trap 'rm -rf "$anchor"' EXIT
mkdir "$anchor/src"
touch "$anchor/src/lib.rs"
printf '[package]\nname = "anchor"\nversion = "0.0.0"\nedition = "2021"\n' >"$anchor/Cargo.toml"

# `cargo sweep --time` accepts whole days only. A stamp file can hold any cutoff. cargo-sweep
# deletes the stamp after each sweep, and a long run moves the cutoff, so each sweep writes it again.
# `date +%s` drops the fraction of the current second, which moves the cutoff back and keeps
# artifacts a little longer. For SWEEP_MAX_AGE=0 the cutoff moves forward instead, so artifacts
# written in the current second are removed too. Base 10 keeps a leading zero from reading as octal.
sweep_target_dir() {
  local now cutoff
  now=$(date +%s)
  if ((10#$SWEEP_MAX_AGE == 0)); then
    cutoff=$((now + 1))
  else
    cutoff=$((now - 10#$SWEEP_MAX_AGE))
  fi
  ((cutoff < 0)) && cutoff=0
  printf '{"secs_since_epoch":%d,"nanos_since_epoch":0}' "$cutoff" >"$anchor/sweep.timestamp"
  CARGO_TARGET_DIR=$1 sweep "${sweep_args[@]}" "$anchor"
}

IFS=: read -ra roots <<<"$SWEEP_ROOTS"
# bash 3.2 treats an empty array as unset under set -u.
for root in ${roots[@]+"${roots[@]}"}; do
  [[ -z $root ]] && continue
  if [[ ! -d $root ]]; then
    echo "skipping missing root: $root" >&2
    failures=$((failures + 1))
    continue
  fi
  if [[ ! -r $root || ! -x $root ]]; then
    echo "cannot read or search root: $root" >&2
    failures=$((failures + 1))
    continue
  fi
  # `cargo sweep --recursive` silently skips projects whose manifest needs their own
  # .cargo/config.toml, such as private registries, because cargo reads config from the
  # working dir. Finding the target dirs avoids loading any project. Hidden dirs such as
  # .worktrees are searched too. Cargo tags every target dir it creates, which rules out
  # unrelated dirs named target, but a project can live below such a dir. A target dir
  # can also be a symlink to a shared dir.
  if ! found=$(find "$root" -name target \( -type d -o -type l \) \
    -exec test -f {}/CACHEDIR.TAG \; -prune -print); then
    echo "could not search all of root: $root" >&2
    failures=$((failures + 1))
  fi
  while IFS= read -r target_dir; do
    [[ -n $target_dir ]] && sweep_target_dir "$target_dir"
  done <<<"$found"
done

IFS=: read -ra target_dirs <<<"$SWEEP_TARGET_DIRS"
for target_dir in ${target_dirs[@]+"${target_dirs[@]}"}; do
  [[ -z $target_dir ]] && continue
  if [[ ! -d $target_dir ]]; then
    echo "skipping missing target dir: $target_dir" >&2
    failures=$((failures + 1))
    continue
  fi
  sweep_target_dir "$target_dir"
done

if ((failures)); then
  echo "$failures sweep(s) failed" >&2
  exit 1
fi
